# oberon.env — cluster environment for DL++ on Oberon
# Usage: source oberon.env

# ── Modules ───────────────────────────────────────────────────────────────────
module purge
module load ffmpeg/
module load uv/

# ── Shared library paths ──────────────────────────────────────────────────────
_FFMPEG_LIB="/shared/opt/linux-rocky9-x86_64/gcc-11.4.1/ffmpeg-6.1.1-gynsavpssxgp4ewikkmsa6jswfgi3ycg/lib"
_LIBCXX_LIB="/shared/opt/linux-rocky9-x86_64/gcc-11.4.1/llvm-17.0.6-ibcxgmojxutzsgeoyywyraq5fmvycsfl/lib/x86_64-unknown-linux-gnu"

export LD_LIBRARY_PATH="${_FFMPEG_LIB}:${_LIBCXX_LIB}:${LD_LIBRARY_PATH:-}"
